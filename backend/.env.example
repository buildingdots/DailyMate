NODE_ENV=development
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dailymate

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth (optional for local dev without social login)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Stripe (optional for local dev without billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Used for Stripe checkout redirect URLs
APP_URL=http://localhost:3000

# API documentation at /api/docs (set to false in production if desired)
SWAGGER_ENABLED=true
