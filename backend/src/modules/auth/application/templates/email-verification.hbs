<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Verify Your DailyMate Account</title>
  </head>
  <body style="margin:0;padding:0;background:#f1f5f9;color:#0f172a;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f1f5f9;padding:32px 16px;">
      <tr>
        <td align="center">
          <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:620px;background:#ffffff;border:1px solid #e2e8f0;border-radius:24px;overflow:hidden;">
            <tr>
              <td align="center" style="padding:40px 32px 28px;border-bottom:1px solid #f1f5f9;">
                <div style="width:68px;height:68px;margin:0 auto 12px;border:8px solid #0f172a;border-left-color:#0d9488;border-radius:50%;box-sizing:border-box;"></div>
                <div style="font-size:26px;line-height:32px;font-weight:800;letter-spacing:0;color:#0f172a;">Daily<span style="color:#0d9488;">Mate</span></div>
                <div style="margin-top:6px;font-size:11px;line-height:16px;letter-spacing:3px;text-transform:uppercase;font-weight:700;color:#94a3b8;">Your Personal Finance Companion</div>
              </td>
            </tr>
            <tr>
              <td style="padding:40px 40px 32px;">
                <div style="text-align:center;margin-bottom:28px;">
                  <div style="display:inline-block;padding:9px 16px;border:1px solid #99f6e4;border-radius:999px;background:#f0fdfa;color:#0d9488;font-size:13px;line-height:18px;font-weight:800;">Security &amp; Account Setup</div>
                  <h1 style="margin:22px 0 10px;font-size:32px;line-height:38px;font-weight:800;letter-spacing:0;color:#0f172a;">Verify your email address</h1>
                  <p style="margin:0 auto;max-width:440px;font-size:16px;line-height:25px;color:#64748b;">Welcome to DailyMate! Confirm your email to secure your account and start your journey toward effortless, private financial clarity.</p>
                </div>

                <div style="text-align:center;margin-bottom:32px;">
                  <a href="{{verificationUrl}}" target="_blank" style="display:inline-block;background:#0f172a;color:#ffffff;text-decoration:none;font-size:16px;line-height:20px;font-weight:800;padding:18px 34px;border-radius:16px;">Verify Email Address &rarr;</a>
                  <p style="margin:14px 0 0;font-size:13px;line-height:18px;color:#94a3b8;">Link expires at <strong style="color:#64748b;">{{tokenExpiryText}}</strong>.</p>
                </div>

                <div style="background:#ecfdf5;border:1px solid #a7f3d0;border-radius:18px;padding:22px 24px;margin-bottom:32px;">
                  <div style="font-size:17px;line-height:23px;font-weight:800;color:#064e3b;margin-bottom:6px;">100% Private &amp; Zero-Knowledge</div>
                  <div style="font-size:15px;line-height:23px;color:#047857;">DailyMate never asks for your NetBanking credentials or passwords. Your transactions and budgets are parsed strictly on-device.</div>
                </div>

                <div style="border-top:1px solid #f1f5f9;padding-top:22px;">
                  <p style="margin:0 0 10px;font-size:13px;line-height:19px;color:#64748b;">Trouble clicking the button? Paste this link into your mobile or desktop browser:</p>
                  <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:14px;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:12px;line-height:18px;color:#475569;word-break:break-all;">{{verificationUrl}}</div>
                  <p style="margin:14px 0 0;font-size:13px;line-height:19px;color:#94a3b8;">Your account must be verified by {{accountDeadlineText}}. We will remind you every 3 days until then.</p>
                </div>
              </td>
            </tr>
            <tr>
              <td align="center" style="background:#f8fafc;border-top:1px solid #e2e8f0;padding:28px 32px;">
                <p style="margin:0 auto 14px;max-width:430px;font-size:13px;line-height:20px;color:#94a3b8;">If you did not request this verification email, you can safely ignore it. Someone may have entered your email by mistake.</p>
                <div style="font-size:12px;line-height:19px;color:#94a3b8;">&copy; {{currentYear}} DailyMate Technologies Inc. All rights reserved.<br>100% Local-First &amp; On-Device Financial Intelligence</div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
